# 복사해서 .env 로 저장하세요. (.env 는 git에 올라가지 않습니다)
SECRET_KEY=change-me
PORT=5000

# ── AWS IAM 자격증명 (Lightsail 배포 또는 로컬 테스트 시 입력, 또는 aws configure 사용) ──
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-northeast-2

# ── S3 파일 스토리지 (local | s3) ──────────────────────────────
STORAGE_BACKEND=local
S3_BUCKET=tubelite-media-yourname

# ── DynamoDB 데이터베이스 (sqlite | dynamodb) ──────────────────
DB_BACKEND=sqlite
DDB_PREFIX=tubelite-

# ── 9주차 · Lambda + SNS ───────────────────────────────────────
# NOTIFY_BACKEND=local           # local | sns
# SNS_TOPIC_ARN=arn:aws:sns:ap-northeast-2:...
